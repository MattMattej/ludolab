{
  "name": "tabletest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b && corepack pnpm --filter @tabletest/web build",
    "typecheck": "tsc -b",
    "test": "corepack pnpm build && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tabletest": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "fast-check": "^3.23.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.8"
  }
}
